[Unit]
Description=Saude Familiar: apagar cadastros nao confirmados, sessoes e links vencidos (%i)
After=network-online.target postgresql@16-main.service

[Service]
Type=oneshot
User=saude
WorkingDirectory=/opt/saude-familiar/server
EnvironmentFile=/etc/saude/%i.env
ExecStart=/opt/node/bin/node src/tarefas.js limpar-contas
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
